# Required: a flat Hevy media directory, or a legacy directory containing images/ and videos/.
EXERCISE_MEDIA_SOURCE=

# Passkey and web settings. These defaults serve a local instance at http://localhost:8080.
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=Hforge

# Optional instance settings.
ADMIN_UIDS=
INVITE_ONLY=
IMAGE_TAG=latest
SESSION_DAYS=90
