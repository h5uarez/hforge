# Keep host-only files and runtime data out of the frontend build context.
node_modules/
**/node_modules/
dist/
**/dist/
data/
**/data/
data-local/
**/data-local/
.data/
**/.data/
media/
**/media/
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example
test-results/
**/test-results/
playwright-report/
**/playwright-report/
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
.git/
.git/**
